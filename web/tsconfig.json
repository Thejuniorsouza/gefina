{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["DOM", "ESNext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": ["src"]
}